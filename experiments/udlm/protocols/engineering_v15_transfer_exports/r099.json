{
  "model": {
    "attention_probs_dropout_prob": 0.1,
    "classifier_dropout": null,
    "hidden_act": "gelu",
    "hidden_dropout_prob": 0.1,
    "hidden_size": 768,
    "initializer_range": 0.02,
    "intermediate_size": 3072,
    "layer_norm_eps": "1e-12",
    "max_position_embeddings": 256,
    "model_type": "bert",
    "num_attention_heads": 12,
    "num_hidden_layers": 12,
    "pad_token_id": 3,
    "position_embedding_type": "absolute",
    "torch_dtype": "float32",
    "type_vocab_size": 2,
    "use_cache": true,
    "vocab_size": 1880
  },
  "training": {
    "antithetic_sampling": true,
    "diffusion": "udlm",
    "ema": 0.9999,
    "global_mean_loss": true,
    "sampling_eps": 0.001,
    "udlm": {
      "conditioning_variant": "film_adaln",
      "empirical_uniform_mix": 0.0002,
      "exclude_special_tokens": false,
      "mask_all_special_tokens": true,
      "mask_mixture_weight": 0.99,
      "noise_eps": 0.001,
      "parameterization": "raw_loo",
      "prior_variant": "mask_rich_empirical",
      "time_embedding_size": 256,
      "zero_init_conditioning": false
    },
    "use_bracket_safe": false
  }
}
